# ncloud-mcp-server 환경 변수 예시 (민간존·공공존 공용)

# ── 존 선택 ───────────────────────────────────────────────────────────────
# public(기본, 민간존) | gov(공공존) | fin(금융존). 인증키는 반드시 해당 존 콘솔에서 발급한 것을 사용한다.
#   민간존 콘솔: https://console.ncloud.com      · API 가이드: https://api.ncloud-docs.com/docs/home
#   공공존 콘솔: https://console.gov-ncloud.com  · API 가이드: https://api-gov.ncloud-docs.com/docs
#   금융존 콘솔: https://console.fin-ncloud.com  · API 가이드: https://api-fin.ncloud-docs.com/docs/api-overview
# NCLOUD_ZONE=public

# ── 필수 — API 인증키 ─────────────────────────────────────────────────────
NCLOUD_ACCESS_KEY=your-access-key
NCLOUD_SECRET_KEY=your-secret-key

# ── 선택 — 리전 코드 (기본 KR) ───────────────────────────────────────────
#   민간존: KR, JPN, SGN, USWN, DEN
#   공공존: KR(KR-CENTRAL), KRS(KR-SOUTH) — Object Storage 는 KR→gov-standard, KRS→gov2-standard 로 서명
#   금융존: FKR(Korea(finance)) — 기본값도 FKR
# NCLOUD_REGION=KR

# ── 선택 — 기본 API Gateway override (존 기본값을 덮어씀) ─────────────────
#   민간존 기본 https://ncloud.apigw.ntruss.com / 공공존 기본 https://ncloud.apigw.gov-ntruss.com
# NCLOUD_API_URL=

# ── 선택 — 시작 시 로딩할 도구 그룹 (미설정 = 전체 ON) ───────────────────
#   예: compute,network / all,-database / dynamic
# NCLOUD_TOOL_GROUPS=dynamic

# ── 선택 — Archive Storage(OpenStack Swift) 사용 시 필수 ──────────────────
#   두 값이 모두 있어야 Archive Storage 도구가 등록된다(Keystone scope에 필요).
# NCLOUD_ARCHIVE_PROJECT_ID=
# NCLOUD_ARCHIVE_DOMAIN_ID=

# ── 선택 — SENS (민간존 전용) ─────────────────────────────────────────────
# NCLOUD_SENS_SERVICE_ID=
# NCLOUD_SENS_MAIL_SERVICE_ID=
# NCLOUD_SENS_BRANDMESSAGE_SERVICE_ID=

# ── 선택 — 기타 튜닝 ─────────────────────────────────────────────────────
# NCLOUD_LANG=ko               # 'en' 이면 영문 메시지
# NCLOUD_TIMEOUT_MS=30000      # API 타임아웃(ms)
# NCLOUD_DEBUG=1               # 요청/응답 디버그 로그
# NCLOUD_RESPONSE_PRUNE=1      # 빈 값 제거
# NCLOUD_RESPONSE_MAXBYTES=0   # 읽기 응답 크기 가드(바이트)
# NCLOUD_STORAGE_ADDRESSING=   # Ncloud Storage 버킷 주소 방식 (virtual-hosted | path)
